# LLM Configuration (options: gemini | ollama)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# Choose a currently available Gemini model from official Google AI documentation (e.g. gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Choose a locally pulled Ollama model (e.g. llama3, mistral)
OLLAMA_MODEL=

# Provider Configuration
WEATHER_PROVIDER=open-meteo
FLIGHT_PROVIDER=opensky
FLIGHT_API_KEY=
FLIGHT_CLIENT_ID=
FLIGHT_CLIENT_SECRET=

# Application & Runtime Settings
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
DATA_MODE=synthetic
